GEE_PROJECT_ID=your-earth-engine-project-id
META_API_KEY=your-meta-llama-api-key
META_API_URL=https://your-meta-api-base-url
META_MODEL=your-meta-model-id
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
ALERT_INGEST_TOKEN=replace-with-a-long-random-secret
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_OTP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SIMULATOR_BROADCAST_TOKEN=Gjxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEMO_LOGIN_PIN=SetYourOwnDemoPin
